{
  "name": "todo_qa",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "generate": "tsx tools/generate/index.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "chalk": "6.0.0",
    "eslint": "^8.57.0",
    "fs-extra": "^11.4.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "inquirer": "14.0.2",
    "lint-staged": "17.3.0",
    "node-plop": "0.32.3",
    "plop": "4.0.5",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "apps/frontend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "pnpm --filter frontend exec eslint"
    ],
    "packages/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "apps/backend/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "resolutions": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
