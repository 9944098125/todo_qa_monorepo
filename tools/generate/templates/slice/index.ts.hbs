import { createSlice, PayloadAction } from '@reduxjs/toolkit';
{{#if requiresApi}}
import { createApi, fetchBaseQuery } from '@reduxjs/toolkit/query/react';
{{/if}}
import { {{pascalCase name}}State } from './types';

const initialState: {{pascalCase name}}State = {
  data: null,
  isLoading: false,
  error: null,
};

export const {{camelCase sliceName}} = createSlice({
  name: '{{camelCase name}}',
  initialState,
  reducers: {
    setLoading: (state, action: PayloadAction<boolean>) => {
      state.isLoading = action.payload;
    },
    setData: (state, action: PayloadAction<any>) => {
      state.data = action.payload;
    },
    setError: (state, action: PayloadAction<string | null>) => {
      state.error = action.payload;
    },
  },
});

export const { setLoading, setData, setError } = {{camelCase sliceName}}.actions;
export const reducer = {{camelCase sliceName}}.reducer;

{{#if requiresApi}}
export const api = createApi({
  reducerPath: '{{camelCase name}}Api',
  baseQuery: fetchBaseQuery({ baseUrl: '/api' }),
  endpoints: (builder) => ({
    // Add endpoints here
  }),
});

export const { } = api;
{{/if}}

export * from './selectors';
export * from './types';
