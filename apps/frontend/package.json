    "react-app-polyfill": "3.0.0",
    "react-dom": "19.2.8",
    "react-google-autocomplete": "2.7.5",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.11",
    "react-is": "19.2.8",
